@model Car.Core.Entities.Car

<h1>Car Details</h1>

@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
    <div class="mb-3">
        <img src="@Model.ImageUrl" style="max-width:600px; width:100%; border-radius:6px;" />
    </div>
}

<dl class="row">
    <dt class="col-sm-2">Make</dt>
    <dd class="col-sm-10">@Model.Make</dd>

    <dt class="col-sm-2">Model</dt>
    <dd class="col-sm-10">@Model.Model</dd>

    <dt class="col-sm-2">Year</dt>
    <dd class="col-sm-10">@Model.Year</dd>

    <dt class="col-sm-2">Color</dt>
    <dd class="col-sm-10">@Model.Color</dd>

    <dt class="col-sm-2">Price</dt>
    <dd class="col-sm-10">@Model.Price</dd>
</dl>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</p>

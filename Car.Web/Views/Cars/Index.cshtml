@model IEnumerable<Car.Core.Entities.Car>

<h1 class="mb-4">Car List</h1>

<p>
    <a asp-action="Create" class="btn btn-warning mb-4">Create New</a>
</p>

@if (Model == null || !Model.Any())
{
    <p>No cars found.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var car in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">

                    @if (!string.IsNullOrEmpty(car.ImageUrl))
                    {
                        <img src="@car.ImageUrl"
                             class="card-img-top"
                             style="height:220px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light"
                             style="height:220px;">
                            <span class="text-muted">No image</span>
                        </div>
                    }

                    <div class="card-body">
                        <h5 class="card-title">@car.Make @car.Model</h5>

                        <p class="card-text">
                            <strong>Year:</strong> @car.Year <br />
                            <strong>Color:</strong> @car.Color <br />
                            <strong>Price:</strong> @car.Price €
                        </p>
                    </div>

                    <div class="card-footer text-center">
                        <a asp-action="Details" asp-route-id="@car.Id"
                           class="btn btn-success btn-sm me-1">Details</a>

                        <a asp-action="Edit" asp-route-id="@car.Id"
                           class="btn btn-info btn-sm me-1">Edit</a>

                        <a asp-action="Delete" asp-route-id="@car.Id"
                           class="btn btn-danger btn-sm">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@model IEnumerable<Car.Core.Entities.Car>

<h1>Cars</h1>

@if (Model == null || !Model.Any())
{
    <p>No cars found.</p>
}
else
{
    <ul>
        @foreach (var car in Model)
        {
            <li>
                @car.Make @car.Model (@car.Year)
                - <a asp-action="Details" asp-route-id="@car.Id">Details</a>
            </li>
        }
    </ul>
}

